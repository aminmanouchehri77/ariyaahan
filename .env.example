# Copy to .env for local development. Keep real credentials out of Git.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local MySQL application account. Prefer loading DB_PASSWORD from the
# machine's protected secret store or scripts/.local-db.ps1.
DB_ENGINE=django.db.backends.mysql
DB_NAME=ariaahan
DB_USER=ariaahan_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Local OTP uses the console. For real SMS, set the Kavenegar credentials
# and use the approved Verify Lookup template configured for this account.
SMS_BACKEND=accounts.sms.ConsoleSMSBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_TIMEOUT=10
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Optional browser push. Generate VAPID keys only when push delivery is enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Production URL, Google Play TWA identity, and payment gateway values are
# deployment-specific and must be supplied after those accounts are selected.
PUBLIC_SITE_URL=
TWA_PACKAGE_NAME=
TWA_SHA256_CERT_FINGERPRINTS=
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
DEFAULT_FROM_EMAIL=noreply@localhost
