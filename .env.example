# Copy to .env for local development. Keep real credentials out of Git.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Local MySQL application account. Prefer loading DB_PASSWORD from the
# machine's protected secret store or scripts/.local-db.ps1.
DB_ENGINE=django.db.backends.mysql
DB_NAME=ariaahan
DB_USER=ariaahan_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Local OTP uses the console. For real SMS, set the Kavenegar credentials
# and use approved Verify Lookup templates configured for this account.
# Acceptance uses a separate template because it verifies a different action.
SMS_BACKEND=accounts.sms.ConsoleSMSBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_ACCEPT_TEMPLATE=
KAVENEGAR_TIMEOUT=10
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Optional browser push. Generate VAPID keys only when push delivery is enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PRIVATE_KEY_FILE=
VAPID_CLAIMS_EMAIL=
PUSH_DELIVERY_ENABLED=0
PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,fcmregistrations.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com

# Production URL and Google Play TWA identity are deployment-specific.
PUBLIC_SITE_URL=
TWA_PACKAGE_NAME=
TWA_SHA256_CERT_FINGERPRINTS=

# SEP (Saman) internet payment gateway. Fill SEP_TERMINAL_ID with the terminal
# issued by SEP, register this server's public IP in the SEP merchant panel,
# set PUBLIC_SITE_URL to the final HTTPS origin, then set PAYMENT_ENABLED=1.
# Bank callback URL to register: <PUBLIC_SITE_URL>/payment/sep/callback/
PAYMENT_ENABLED=0
PAYMENT_PROVIDER=sep
SEP_TERMINAL_ID=
# The endpoints below default to SEP's production URLs; override only if SEP
# gives you different ones.
# SEP_TOKEN_URL=https://sep.shaparak.ir/onlinepg/onlinepg
# SEP_PAYMENT_URL=https://sep.shaparak.ir/OnlinePG/OnlinePG
# SEP_VERIFY_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction
# SEP_REVERSE_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/ReverseTransaction
SEP_TOKEN_EXPIRY_MINUTES=20
SEP_TIMEOUT=15

# e-Namad trust seal: values from the enamad.ir panel for the final domain.
# ENAMAD_ID / ENAMAD_CODE come from the badge snippet (id=...&Code=...).
# ENAMAD_META_CODE is the domain-verification meta tag content, if requested.
ENAMAD_ID=
ENAMAD_CODE=
ENAMAD_META_CODE=
# Optional Samandehi (samandehi.ir) badge.
SAMANDEHI_ID=
SAMANDEHI_CODE=

DEFAULT_FROM_EMAIL=noreply@localhost
